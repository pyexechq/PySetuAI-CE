# HelixGuard AI — Production environment template
# Copy to a secure secrets store (e.g. .env.production on the host, K8s Secret, or CI vars).
# NEVER commit filled values to git.
#
# See docs/security/jwt-secret-rotation.md for JWT bootstrap and rotation.
# See docs/security/vault-deployment.md for Vault AppRole and tenant secrets.

# --- Core ---
DEBUG=false
DEPLOYMENT_MODE=saas
PLATFORM_PORTAL_ENABLED=true
PLATFORM_TENANT_SLUG=platform
APP_BASE_DOMAIN=helixguard.example.com
APP_BASE_SCHEME=https
FRONTEND_URL=https://app.helixguard.example.com
CORS_ORIGINS=["https://app.helixguard.example.com"]

# --- Database (use strong credentials; managed Postgres recommended) ---
DATABASE_URL=postgresql+asyncpg://helixguard:REPLACE_POSTGRES_PASSWORD@postgres:5432/helixguard
POSTGRES_PASSWORD=REPLACE_POSTGRES_PASSWORD

# --- Redis ---
REDIS_URL=redis://:REPLACE_REDIS_PASSWORD@redis:6379/0

# --- JWT (choose ONE approach) ---
# Option A — environment variable (minimum bar for non-debug startup):
# Generate: ./scripts/generate-jwt-secret.sh
JWT_SECRET_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Option B — Vault-managed JWT (recommended for production):
# VAULT_ENABLED=true
# VAULT_ADDR=https://vault.helixguard.example.com:8200
# VAULT_AUTH_METHOD=approle
# VAULT_ROLE_ID=REPLACE_VAULT_ROLE_ID
# VAULT_SECRET_ID=REPLACE_VAULT_SECRET_ID
# VAULT_MOUNT_PATH=secret
# Bootstrap once: ./scripts/vault-bootstrap-jwt-secret.sh
# Leave JWT_SECRET_KEY empty when using Vault path secret/helixguard/platform/jwt_secret

# --- Hashicorp Vault (tenant API keys + optional JWT) ---
VAULT_ENABLED=true
VAULT_ADDR=https://vault.helixguard.example.com:8200
VAULT_AUTH_METHOD=approle
VAULT_ROLE_ID=
VAULT_SECRET_ID=
VAULT_MOUNT_PATH=secret

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_REQUESTS=10
RATE_LIMIT_AUTH_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# --- OIDC / SSO ---
OIDC_ENABLED=true
OIDC_JIT_PROVISION_DEFAULT=false
OIDC_DEFAULT_ROLE=developer

# --- OPA (gateway ABAC) ---
OPA_ENABLED=true
OPA_BASE_URL=http://opa:8181
OPA_FAIL_OPEN=false

# --- Observability ---
OTEL_ENABLED=true
OTEL_EXPORTER=otlp
OTEL_OTLP_ENDPOINT=https://otel-collector.helixguard.example.com:4317

# --- SMTP (report delivery) ---
SMTP_ENABLED=true
SMTP_HOST=smtp.helixguard.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@helixguard.example.com
SMTP_USE_TLS=true

# --- LLM upstream (tenant keys preferred via Settings; globals optional) ---
OLLAMA_ENABLED=false
GATEWAY_MOCK_MODE=false
AIR_GAP_MODE=false

# --- Frontend (build-time / runtime) ---
NEXT_PUBLIC_API_URL=https://app.helixguard.example.com/api/v1
# Do NOT set NEXT_PUBLIC_DEMO_LOGIN_* in production builds.

# --- Ports (Docker Compose / reverse proxy) ---
BACKEND_PORT=8001
FRONTEND_PORT=3000
