# Docker Compose environment (optional — defaults work out of the box)
BACKEND_PORT=8001
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=/api/v1

# Local Ollama (default ON — backend reaches host Ollama via host.docker.internal)
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_DEFAULT_MODEL=llama3.2

# Optional: forward to OpenAI instead (takes priority over Ollama)
# OPENAI_API_KEY=sk-...

# Hashicorp Vault for tenant API keys (enabled by default — UI at http://localhost:8200)
VAULT_ENABLED=true
VAULT_ADDR=http://vault:8200
VAULT_AUTH_METHOD=token
VAULT_TOKEN=dev-root-token
# VAULT_AUTH_METHOD=approle
# VAULT_ROLE_ID=
# VAULT_SECRET_ID=
VAULT_MOUNT_PATH=secret

# Scheduled LLM routing rebalance (Celery beat, UTC)
# LLM_REBALANCE_SCHEDULE_ENABLED=true
# LLM_REBALANCE_CRON_HOUR=2
# LLM_REBALANCE_CRON_MINUTE=0
